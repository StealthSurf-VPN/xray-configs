{
	"log": {
		"loglevel": "none",
		"error": "none",
		"access": "none"
	},
	"dns": {
		"servers": ["https://8.8.8.8/dns-query", "https://1.1.1.1/dns-query"],
		"queryStrategy": "UseIPv4"
	},
	"routing": {
		"domainStrategy": "AsIs",
		"rules": []
	},
	"inbounds": [
		{
			"listen": "0.0.0.0",
			"port": 10000,
			"protocol": "shadowsocks",
			"tag": "shadowsocks",
			"settings": {
				"method": "chacha20-ietf-poly1305",
				"password": "",
				"network": "tcp,udp"
			},
			"sniffing": {
				"enabled": true,
				"destOverride": ["http", "tls", "quic"],
				"routeOnly": true
			}
		}
	],
	"outbounds": [
		{
			"protocol": "freedom",
			"tag": "direct",
			"streamSettings": {
				"sockopt": {
					"tcpNoDelay": true
				}
			}
		},
		{
			"protocol": "blackhole",
			"tag": "block"
		}
	]
}
